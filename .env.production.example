# Identidad del despliegue
COMPOSE_PROJECT_NAME=valtieris-marketing
MARKETING_IMAGE_TAG=1.1.0
MARKETING_API_IMAGE=valtieris/marketing-api
MARKETING_WEB_IMAGE=valtieris/marketing-web
MARKETING_BIND_ADDRESS=127.0.0.1
MARKETING_HTTP_PORT=8080
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
APP_COMMIT=unknown
APP_BUILD_TIME=unknown

# Sitio público. Sustituir cuando exista dominio o endpoint HTTPS.
VITE_SITE_URL=https://replace-with-domain.example.invalid
VITE_API_URL=/api
VITE_CONTACT_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_LEGAL_ENTITY=Valtieris
VITE_LEGAL_ADDRESS=
VITE_ENABLE_ANALYTICS=false
VITE_GTM_ID=
VITE_GA_MEASUREMENT_ID=

# Backend
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8081
DB_URL=jdbc:oracle:thin:@//REPLACE_WITH_ORACLE_HOST:1521/XEPDB1
DB_USERNAME=EVALUATION_APP
DB_PASSWORD=
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=5
CORS_ALLOWED_ORIGINS=https://replace-with-domain.example.invalid
IP_HASH_SALT=
TRUST_FORWARDED_HEADERS=true
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW=15m
SPAM_MIN_COMPLETION_TIME=2s
SPAM_MAX_COMPLETION_TIME=24h
SPAM_DUPLICATE_WINDOW=3m
SPAM_MAX_URLS=2

# Correo. Mantener desactivado hasta contar con SMTP real.
MAIL_HEALTH_ENABLED=false
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=
CONTACT_RECIPIENT=

# Respaldo Oracle Data Pump
ORACLE_DIRECTORY=DATA_PUMP_DIR
ORACLE_BACKUP_DIR=./backups/oracle
ORACLE_DUMP_RETENTION_DAYS=14
# Conexión Data Pump segura, preferentemente mediante Oracle Wallet.
# Ejemplo: /@VALTIERIS_BACKUP
ORACLE_DATAPUMP_CONNECT=
ORACLE_RESTORE_TABLE_ACTION=SKIP
